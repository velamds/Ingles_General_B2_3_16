k": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 3, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn11le16ob06re2aud01", "coverimg": "engenn11le16ob06re2img05.jpg", "images": [{"image": "engenn11le16ob06re2img05.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn11le16ob06re2img05.jpg", "text": "<span class=\"strong\">Peter</span>: Well, I just blew it again!\n</br><span class=\"strong\">Sally</span>: What do you mean?\n</br><span class=\"strong\">Peter</span>: I had a big argument with Amy.\n</br><span class=\"strong\">Sally</span>: What about?\n</br><span class=\"strong\">Peter</span>: She is leaving for Africa at the end of the week to do some volunteer work and didn't bother to tell me until today.\n</br><span class=\"strong\">Sally</span>: Why did she wait?\n</br><span class=\"strong\">Peter</span>: She said she didn't know, but she must have had some inclination. I told her she should have told me earlier so I could have been part of the decision process.", "id": 1, "time": "100"}, {"image": "engenn11le16ob06re2img02.jpg", "text": "<span class=\"strong\">Sally</span>: Oh, Peter. I wouldn't have done that.\n</br><span class=\"strong\">Peter</span>: Why not? I'm her boyfriend.\n</br><span class=\"strong\">Sally</span>: You haven't been seeing each other long enough. You shouldn't try to control independent women. It never works out.\n</br><span class=\"strong\">Peter</span>: You're right. I'm not as independent as Amy. She is this smart, adventurous woman.\n</br><span class=\"strong\">Sally</span>: As smart and adventurous as me? Haha.\n</br><span class=\"strong\">Peter</span>: Yes, and she is as tall as you are too, but she can't dance as well as you can. Haha. Anyway, I know she cares about our relationship as much as I do, I guess I'm scared that she is going to dump me.", "id": 2, "time": "37000"}, {"image": "engenn11le16ob06re2img01.jpg", "text": "<span class=\"strong\">Sally</span>: You are feeling insecure. That is understandable, but don't try to force the issue too much. Let the relationship go where it is going to go. Just be patient.\n</br><span class=\"strong\">Peter</span>: That's good advice.\n</br><span class=\"strong\">Sally</span>: Did you say anything really terrible that could be construed as a deal breaker?\n</br><span class=\"strong\">Peter</span>: No. Not really.\n</br><span class=\"strong\">Sally</span>: Good. Then I think you'll be ok. Where is she going to in Africa?\n</br><span class=\"strong\">Peter</span>: She is going to Lesotho.\n</br><span class=\"strong\">Sally</span>: Oh wow! I would love to go there. It is not as beautiful as South Africa, but I hear it's a captivating place.\n</br><span class=\"strong\">Peter</span>: You want to go to South Africa?\n</br><span class=\"strong\">Sally</span>: Oh yeah. It's supposed to be spectacular.\n</br><span class=\"strong\">Peter</span>: Hmmm. That gives me an idea.", "id": 3, "time": "83000"}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "All's Well That Ends Well", "type": "lesson_name"}, {"content": "Lessons Learned", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "B2.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Exchange information about unlikely events or fairly certain conditions that will be fulfilled in present, past or future  in spoken or written texts and in work and social contexts.", "type": "primary"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_2"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_3"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_4"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_6"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_7"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_8"}]}, {"content": "engenn11le16ob06re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Uses of the Perfect Modals ", "type": "heading"}, {"content": "<span class=\"italic\">Perfect modals </span> are useful when you want to talk about past possibility, certainty and regret.", "type": "describer"}, {"content": "Refer to the chart for a summary of the different Perfect modals and their uses.</br></br>Remember the form is: </br></br> subject + modal + have + past participle", "type": "text"}, {"content": "{\"rows\":6,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Perfect Modal</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Use</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Example</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Could have/couldn't have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"you were able to or had the option to do something in the past but do not any longer\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">You <span class=\\\"strong\\\">could have been </span>famous - you were a much better tennis player than the others.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Should have/shouldn't have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" you were obligated to do this in the past for the current result to be favorable \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">shouldn't have said</span> I didn't like the dress. Now she's upset.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Would have/wouldn't have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"you were unaware of a condition in the past and the condition no longer exists\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">would have picked you up </span>  if I had known you were coming here as well.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"May have/may not have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"you were not certain whether an event did or did not happen in the past\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">may have told</span> her about the party. I can' t remember.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Must have/must not have \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"you are fairly sure, from evidence that this happened in the past in all probability\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">He <span class=\\\"strong\\\">must not have turned off </span>his phone, because it's going straight to voicemail.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "She must have had some inclination. ", "type": "example"}, {"content": "I told her she should have told me earlier. ", "type": "example"}, {"content": "I could have been part of the decision process.", "type": "example"}, {"content": "I wouldn't have done that.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "The Comparative Clause: As ...  As", "type": "heading"}, {"content": "You can show comparisons and contrast using the structure as ... as ", "type": "describer"}, {"content": "You can use as ... as in the following pattern:", "type": "text"}, {"content": "(not) <span class=\"strong\">as </span>adjective/adverb <span class=\"strong\">as</span></br>   <span class=\"italic\">She is not<span class=\"strong\"> as independent as </span>her sister.</br> An only child develops <span class=\"strong\">as well as </span>a child with siblings.", "type": "text"}, {"content": "You can use as ... as in these ways: <ol><li> to emphasize two equal elements<br/>Example:</br><span class=\"italic\">He is <span class=\"strong\">as strong as </span>his brother.</span></li> <li>  to show that two things are slightly unequal</br>Example:</br><span class = \"italic\">Jim does not like comedies <span class=\"strong\">as much as</span> I do.</span> </li> <li> to emphasize a difference</br>Example:</br><span class = \"italic\">She is not<span class=\"strong\"> as artistic as</span> I am.</span>", "type": "text"}, {"content": "I'm not as independent as Amy. ", "type": "example"}, {"content": "As smart and adventurous as me? ", "type": "example"}, {"content": "She is as tall as you are too.", "type": "example"}, {"content": "She can't dance as well as you can. ", "type": "example"}, {"content": "I know she cares about our relationship as much as I do.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to blow it", "type": "name"}, {"content": "to make a big mistake", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I just blew it again. ", "type": "example"}, {"content": "engenn11le16ob06aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use if you think you made a big mistake.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "inclination", "type": "name"}, {"content": "the natural tendency someone has to do something in a particular way", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: She must have had some inclination.", "type": "example"}, {"content": "engenn11le16ob06aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to dump", "type": "name"}, {"content": "to end a romantic relationship", "type": "definition"}, {"content": "(verb) ", "type": "part_speech"}, {"content": "Example: I'm scared that she is going to dump me.", "type": "example"}, {"content": "engenn11le16ob06aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to construe", "type": "name"}, {"content": "to interpret words or actions in a particular way", "type": "definition"}, {"content": "(verb) ", "type": "part_speech"}, {"content": "Example: Did you say anything really terrible that could be construed as a deal breaker?", "type": "example"}, {"content": "engenn11le16ob06aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "captivating", "type": "name"}, {"content": "capable of attracting and holding interest", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: I hear it's a captivating place.", "type": "example"}, {"content": "engenn11le16ob06aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "spectacular", "type": "name"}, {"content": "amazing; dramatic; eye-catching", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: It's supposed to be spectacular.", "type": "example"}, {"content": "engenn11le16ob06aud06", "type": "audio"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I research other culture's New Year traditions.", "type": "text"}, {"content": "I take notes on this video.", "type": "text"}, {"content": "I take note of similarities and differences between my country's traditions.", "type": "text"}, {"content": "I explain my descriptions.", "type": "text"}, {"content": "I present it to a group.", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "Pick a country and search online for a video about how the people there celebrate New Year.", "type": "text"}, {"content": "Write down the similarities and differences with your country's New Year traditions.", "type": "text"}, {"content": "Make notes comparing and contrasting the two events.", "type": "text"}, {"content": "Get into small groups and share your findings with your partners.", "type": "text"}]}]}