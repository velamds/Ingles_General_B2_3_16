 "_data": [{"content": "researched the trip.", "type": "text"}], "id": 2, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "The narrator has already ...", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}], "id": 0}, {"responses": [{"_data": [{"content": "her partner has asked about bringing his mother.", "type": "text"}], "id": 0, "correct": 0, "selected": 0}, {"_data": [{"content": "her partner has invited his mother without asking.", "type": "text"}], "id": 1, "correct": 1, "selected": 0}, {"text": "", "_data": [{"content": "her partner got two tickets.", "type": "text"}], "id": 2, "correct": 0, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "The narrator is angry because ...", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}], "id": 1}, {"responses": [{"_data": [{"content": "to think more carefully next time.", "type": "text"}], "id": 0, "correct": 0, "selected": 0}, {"_data": [{"content": "to get her aunt to come.", "type": "text"}], "id": 1, "correct": 1, "selected": 0}, {"text": "", "_data": [{"content": "to spend less time together.", "type": "text"}], "id": 2, "correct": 0, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "The narrator's solution is ...", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}], "id": 2}], "_data": [{"type": "instructions", "contents": [{"content": " Dealing with family matters can be difficult.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Read the text.